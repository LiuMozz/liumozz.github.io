---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout 
  title="💻 技术博客 | 猛男妙妙屋" 
  description="进入猛男妙妙屋的技术博客，记录开发日常、系统架构思考和踩坑记录。"
>
  <div class="blog-catalog-page">
    <header class="catalog-header">
      <h1 class="page-title text-gradient-cyan">💻 技术博客</h1>
      <p class="page-subtitle">学而不思则罔，思而不学则殆。这里记录我探索数字世界的点点滴滴。</p>
    </header>

    <div class="catalog-container">
      {posts.length > 0 ? (
        <div class="posts-list">
          {posts.map(post => (
            <article class="post-card glass glow-card accent-cyan">
              <div class="post-card-content">
                <header class="post-card-header">
                  <span class="post-card-date">
                    📅 {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                  </span>
                  <a href={`/posts/${post.id}`} class="post-card-title-link">
                    <h2 class="post-card-title">{post.data.title}</h2>
                  </a>
                </header>
                
                <p class="post-card-desc">{post.data.description || "暂无描述..."}</p>
                
                <footer class="post-card-footer">
                  {post.data.tags.length > 0 && (
                    <div class="post-card-tags">
                      {post.data.tags.map(tag => (
                        <a href={`/tags/${tag}`} class="tag-badge">#{tag}</a>
                      ))}
                    </div>
                  )}
                  <a href={`/posts/${post.id}`} class="btn-read-more">阅读全文 →</a>
                </footer>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="no-posts glass">
          <p>📭 暂无文章，敬请期待！</p>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .blog-catalog-page {
    padding: 2rem 0;
  }

  .catalog-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: hsl(var(--text-secondary));
    font-size: 1.05rem;
  }

  .catalog-container {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-card {
    padding: 2rem;
    border-color: hsla(var(--border-glass));
    transition: var(--transition-smooth);
  }

  .post-card:hover {
    border-color: hsla(var(--neon-cyan), 0.4);
    box-shadow: 0 10px 25px -5px hsla(var(--neon-cyan), 0.2);
  }

  .post-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .post-card-date {
    font-size: 0.85rem;
    color: hsl(var(--text-muted));
    font-family: monospace;
  }

  .post-card-title-link {
    text-decoration: none;
    color: inherit;
  }

  .post-card-title {
    font-size: 1.6rem;
    font-weight: 700;
    transition: var(--transition-smooth);
  }

  .post-card:hover .post-card-title {
    color: hsl(var(--neon-cyan));
  }

  .post-card-desc {
    color: hsl(var(--text-secondary));
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .post-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid hsla(var(--border-glass));
    padding-top: 1rem;
  }

  .post-card-tags {
    display: flex;
    gap: 0.6rem;
  }

  .tag-badge {
    font-size: 0.78rem;
    color: hsl(var(--text-secondary));
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid hsla(var(--border-glass));
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-decoration: none;
    transition: var(--transition-smooth);
  }

  .tag-badge:hover {
    color: hsl(var(--neon-cyan));
    border-color: hsl(var(--neon-cyan));
    background: hsla(var(--neon-cyan), 0.05);
  }

  .btn-read-more {
    font-size: 0.9rem;
    font-weight: 600;
    color: hsl(var(--neon-cyan));
    text-decoration: none;
    transition: var(--transition-smooth);
  }

  .btn-read-more:hover {
    text-shadow: 0 0 5px hsla(var(--neon-cyan), 0.5);
    transform: translateX(3px);
  }

  .no-posts {
    padding: 3rem;
    text-align: center;
    color: hsl(var(--text-secondary));
  }
</style>
