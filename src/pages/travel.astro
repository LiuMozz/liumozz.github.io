---
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoModal from '../components/VideoModal.astro';

const travelVideos = [
  {
    title: "Mountain Train Journey",
    description: "雪山深处的红色列车，穿透寒冷与迷雾的浪漫极地铁道旅行。",
    videoUrl: "https://media.w3.org/2010/05/bunny/trailer.mp4",
    thumbnailUrl: "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=600&auto=format&fit=crop&q=80",
    tag: "雪国列车",
    accent: "orange" as const
  },
  {
    title: "Tokyo Neon Streets",
    description: "东京街头的迷离霓虹灯，夜晚雨水折射出的科幻都市氛围。",
    videoUrl: "https://vjs.zencdn.net/v/oceans.mp4",
    thumbnailUrl: "https://images.unsplash.com/photo-1540959733332-eab4deceeaf7?w=600&auto=format&fit=crop&q=80",
    tag: "都市穿梭",
    accent: "cyan" as const
  },
  {
    title: "Ancient Forest River",
    description: "无人机视角俯瞰茂密的原始森林与碧绿流淌的林间溪流。",
    videoUrl: "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4",
    thumbnailUrl: "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&auto=format&fit=crop&q=80",
    tag: "自然秘境",
    accent: "emerald" as const
  },
  {
    title: "自驾青甘大环线",
    description: "很多“野生”景点远比景区美多啦！跟随镜头探寻大西北的绝美自然风光。",
    videoUrl: "https://open.douyin.com/player/video?vid=7122245769440005390&autoplay=1",
    thumbnailUrl: "https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=600&auto=format&fit=crop&q=80",
    tag: "青甘自驾",
    accent: "orange" as const
  }
];
---

<Layout 
  title="✈️ 旅行见闻 | 猛男妙妙屋" 
  description="进入猛男妙妙屋的旅行见闻，用光影记录世界的每一个精彩瞬间。"
>
  <div class="travel-page">
    <div class="travel-header">
      <h1 class="page-title text-gradient-orange">✈️ 旅行见闻</h1>
      <p class="page-subtitle">身体和灵魂，总有一个要在路上。悬停卡片预览，点击观看高清视频。</p>
    </div>

    <!-- Gallery Grid -->
    <div class="video-grid-container">
      {travelVideos.map(video => (
        <VideoCard 
          title={video.title}
          description={video.description}
          videoUrl={video.videoUrl}
          thumbnailUrl={video.thumbnailUrl}
          tag={video.tag}
          accent={video.accent}
        />
      ))}
    </div>
  </div>

  <!-- Shared Video Modal -->
  <VideoModal />
</Layout>

<style>
  .travel-page {
    padding: 2rem 0;
  }

  .travel-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: hsl(var(--text-secondary));
    font-size: 1.05rem;
  }

  .video-grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }
</style>
