---
import { songs, type Song } from '../data/songs';

// Separate the public and original lists
const publicSongs = songs.filter(s => s.type === 'public');
const originalSongs = songs.filter(s => s.type === 'original');
---

<div class="music-player-container glass" id="custom-music-player">
  <div class="player-left">
    <!-- Vinyl Disc Section -->
    <div class="vinyl-container">
      <div class="vinyl-arm" id="player-arm"></div>
      <div class="vinyl-disc-large" id="player-vinyl">
        <div class="vinyl-center" id="vinyl-cover-art" style={`background-image: url('${songs[0].cover}')`}></div>
      </div>
    </div>
    
    <!-- Audio waves canvas -->
    <div class="canvas-container">
      <canvas id="waveform-canvas"></canvas>
    </div>
  </div>

  <div class="player-right">
    <!-- Song Info & BGM Button Header -->
    <div class="song-meta-wrapper">
      <div class="song-meta">
        <h2 class="song-title text-gradient-purple" id="player-song-title">{songs[0].title}</h2>
        <p class="song-artist" id="player-song-artist">{songs[0].artist}</p>
      </div>
      <button class="btn-background glass" id="btn-background" aria-label="Set Homepage BGM">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        <span>Background</span>
      </button>
    </div>

    <!-- Lyrics Display -->
    <div class="lyrics-container" id="lyrics-scroll">
      <div class="lyrics-wrapper" id="lyrics-content">
        <p class="lyric-line active">正在加载歌词...</p>
      </div>
    </div>

    <!-- Play Controls -->
    <div class="player-controls">
      <!-- HTML5 Audio -->
      <audio id="main-audio" src={songs[0].url} transition:persist></audio>
      
      <!-- Progress Bar -->
      <div class="progress-bar-container">
        <span class="time-label" id="current-time">0:00</span>
        <input type="range" class="progress-slider" id="progress-bar" value="0" min="0" max="100" />
        <span class="time-label" id="duration-time">--:--</span>
      </div>
      
      <!-- Bottom Controls Row -->
      <div class="controls-bottom-row">
        <div class="empty-placeholder"></div>
        
        <!-- Buttons -->
        <div class="control-buttons">
          <button class="btn-ctrl" id="btn-prev" aria-label="Previous Song">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><polygon points="19 20 9 12 19 4 19 20"></polygon><line x1="5" y1="19" x2="5" y2="5"></line></svg>
          </button>
          <button class="btn-ctrl btn-play-pause glass" id="btn-play" aria-label="Play/Pause">
            <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" class="icon-play"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" class="icon-pause hidden"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
          </button>
          <button class="btn-ctrl" id="btn-next" aria-label="Next Song">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><polygon points="5 4 15 12 5 20 5 4"></polygon><line x1="19" y1="5" x2="19" y2="19"></line></svg>
          </button>
        </div>

        <!-- Volume Bar -->
        <div class="volume-container">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" class="vol-icon"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
          <input type="range" class="volume-slider" id="volume-bar" value="80" min="0" max="100" />
        </div>
      </div>
    </div>

    <!-- Play List Selection: Divided into 2 Columns -->
    <div class="playlist-section-two-cols">
      <!-- Left Column: 公网音乐 -->
      <div class="playlist-col">
        <h3 class="playlist-header">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none" class="icon-globe"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          <span>公网音乐</span>
        </h3>
        <div class="playlist-items" id="playlist-public">
          {publicSongs.map((song, idx) => (
            <button 
              class={`playlist-item glass ${idx === 0 ? "playing" : ""}`} 
              data-id={song.id}
              data-title={song.title}
              data-artist={song.artist}
              data-url={song.url}
              data-cover={song.cover}
              data-lyrics-url={song.lyricsUrl}
            >
              <img src={song.cover} alt="Cover" class="playlist-cover" />
              <div class="playlist-meta">
                <span class="playlist-title">{song.title}</span>
                <span class="playlist-artist">{song.artist}</span>
              </div>
              <span class="bgm-tag hidden">BGM</span>
              <span class="playlist-status-icon">▶</span>
            </button>
          ))}
        </div>
        {publicSongs.length > 5 && (
          <button class="btn-expand glass" id="btn-expand-public" data-target="playlist-public">展开更多 📂</button>
        )}
      </div>

      <!-- Right Column: 原创音乐 -->
      <div class="playlist-col">
        <h3 class="playlist-header">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none" class="icon-sparkle"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <span>原创音乐</span>
        </h3>
        <div class="playlist-items" id="playlist-original">
          {originalSongs.map((song) => (
            <button 
              class="playlist-item glass" 
              data-id={song.id}
              data-title={song.title}
              data-artist={song.artist}
              data-url={song.url}
              data-cover={song.cover}
              data-lyrics-url={song.lyricsUrl}
            >
              <img src={song.cover} alt="Cover" class="playlist-cover" />
              <div class="playlist-meta">
                <span class="playlist-title">{song.title}</span>
                <span class="playlist-artist">{song.artist}</span>
              </div>
              <span class="bgm-tag hidden">BGM</span>
              <span class="playlist-status-icon">▶</span>
            </button>
          ))}
        </div>
        {originalSongs.length > 5 && (
          <button class="btn-expand glass" id="btn-expand-original" data-target="playlist-original">展开更多 📂</button>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .music-player-container {
    display: flex;
    max-width: 1100px;
    width: 100%;
    margin: 2rem auto;
    padding: 2.5rem;
    gap: 3rem;
    border-color: hsla(var(--border-glass));
  }

  /* Left Panel */
  .player-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    width: 320px;
    padding-top: 0.5rem;
  }

  .vinyl-container {
    position: relative;
    width: 280px;
    height: 280px;
    margin-bottom: 2rem;
  }

  .vinyl-arm {
    position: absolute;
    top: 5px;
    right: 25px;
    width: 90px;
    height: 90px;
    border-left: 3px solid #777;
    border-top: 3px solid #777;
    border-radius: 12px 0 0 0;
    transform: rotate(5deg);
    transform-origin: top right;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 5;
  }

  .vinyl-arm::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: -6px;
    width: 16px;
    height: 16px;
    background: #bbb;
    border-radius: 3px;
    box-shadow: 0 0 5px rgba(0,0,0,0.5);
  }

  .vinyl-container.playing .vinyl-arm {
    transform: rotate(26deg);
  }

  .vinyl-disc-large {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, #222 25%, #080808 60%, #151515 90%, #030303 100%);
    border: 4px solid #333;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: spin 15s linear infinite;
    animation-play-state: paused;
    margin: 10px auto;
  }

  .vinyl-container.playing .vinyl-disc-large {
    animation-play-state: running;
  }

  .vinyl-center {
    width: 182px;
    height: 182px;
    border-radius: 50%;
    border: 3px solid #111;
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 10px rgba(0,0,0,0.6);
  }

  .canvas-container {
    width: 100%;
    height: 60px;
    background: rgba(0,0,0,0.2);
    border-radius: var(--radius-sm);
    border: 1px solid hsla(var(--border-glass));
    overflow: hidden;
  }

  #waveform-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Right Panel */
  .player-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Song info & BGM button wrapper */
  .song-meta-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    gap: 1.5rem;
  }

  .song-meta {
    flex: 1;
  }

  .song-title {
    font-size: 2rem;
    margin-bottom: 0.3rem;
  }

  .song-artist {
    color: hsl(var(--text-secondary));
    font-size: 0.95rem;
    font-weight: 500;
  }

  .btn-background {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 20px;
    border: 1px solid hsla(var(--border-glass));
    background: rgba(255, 255, 255, 0.02);
    color: hsl(var(--text-muted));
    cursor: pointer;
    transition: var(--transition-smooth);
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    flex-shrink: 0;
  }

  .btn-background svg {
    color: hsl(var(--text-muted));
    transition: transform 0.3s ease;
  }

  .btn-background:hover {
    color: #ffffff;
    border-color: hsla(var(--neon-purple), 0.4);
    background: rgba(255, 255, 255, 0.05);
  }

  .btn-background:hover svg {
    color: #ffffff;
  }

  .btn-background.active {
    background: hsla(var(--neon-purple), 0.15);
    border-color: hsl(var(--neon-purple));
    color: hsl(var(--neon-purple));
    box-shadow: 0 0 12px hsla(var(--neon-purple), 0.4);
    text-shadow: 0 0 5px hsla(var(--neon-purple), 0.3);
  }

  .btn-background.active svg {
    color: hsl(var(--neon-purple));
    transform: rotate(180deg);
  }

  /* Lyrics Scroller */
  .lyrics-container {
    height: 240px;
    overflow-y: hidden;
    position: relative;
    margin-bottom: 1.2rem;
    border-top: 1px solid hsla(var(--neon-purple), 0.25);
    border-bottom: 1px solid hsla(var(--neon-purple), 0.25);
    box-shadow: 
      inset 0 20px 20px -20px hsla(var(--neon-purple), 0.45),
      inset 0 -20px 20px -20px hsla(var(--neon-purple), 0.45);
    padding: 1rem 0;
  }

  .lyrics-container::before, .lyrics-container::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 80px;
    pointer-events: none;
    z-index: 2;
  }

  .lyrics-container::before {
    top: 0;
    background: linear-gradient(to bottom, hsl(var(--card-bg)) 0%, transparent 100%);
  }

  .lyrics-container::after {
    bottom: 0;
    background: linear-gradient(to top, hsl(var(--card-bg)) 0%, transparent 100%);
  }

  .lyrics-wrapper {
    transition: transform 0.4s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .lyric-line {
    font-size: 0.95rem;
    color: hsl(var(--text-muted));
    text-align: center;
    transition: var(--transition-smooth);
    width: 100%;
    opacity: 0.35;
    padding: 0.2rem 2rem;
    border-radius: 12px;
    background: transparent;
    border-left: 2px solid transparent;
    border-right: 2px solid transparent;
  }

  .lyric-line.active {
    color: hsl(var(--neon-purple));
    font-weight: 800;
    font-size: 1.15rem;
    text-shadow: 0 0 12px hsla(var(--neon-purple), 0.6);
    opacity: 1;
    background: linear-gradient(90deg, transparent 0%, hsla(var(--neon-purple), 0.15) 20%, hsla(var(--neon-purple), 0.25) 50%, hsla(var(--neon-purple), 0.15) 80%, transparent 100%);
    border-left: 2px solid hsla(var(--neon-purple), 0.4);
    border-right: 2px solid hsla(var(--neon-purple), 0.4);
    box-shadow: 0 0 15px hsla(var(--neon-purple), 0.15);
  }

  /* Controls layout */
  .player-controls {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1.2rem;
  }

  .progress-bar-container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .time-label {
    font-family: monospace;
    font-size: 0.85rem;
    color: hsl(var(--text-muted));
    width: 40px;
  }

  .progress-slider, .volume-slider {
    flex: 1;
    -webkit-appearance: none;
    background: rgba(255,255,255,0.08);
    height: 6px;
    border-radius: 3px;
    outline: none;
    cursor: pointer;
  }

  .progress-slider::-webkit-slider-thumb, .volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: hsl(var(--neon-purple));
    box-shadow: 0 0 8px hsl(var(--neon-purple));
    transition: transform 0.1s ease;
  }

  .progress-slider::-webkit-slider-thumb:hover, .volume-slider::-webkit-slider-thumb:hover {
    transform: scale(1.3);
  }

  .control-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .btn-ctrl {
    background: transparent;
    border: none;
    color: hsl(var(--text-secondary));
    cursor: pointer;
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-ctrl:hover {
    color: #ffffff;
    transform: scale(1.1);
  }

  .btn-play-pause {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: hsla(var(--neon-purple), 0.15);
    border: 1px solid hsla(var(--neon-purple), 0.3);
    color: hsl(var(--neon-purple));
  }

  .btn-play-pause:hover {
    background: hsla(var(--neon-purple), 0.3);
    border-color: hsla(var(--neon-purple), 0.6);
    box-shadow: 0 0 15px hsla(var(--neon-purple), 0.4);
    color: #ffffff;
  }

  .hidden {
    display: none !important;
  }

  .volume-container {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 150px;
    margin: 0;
  }

  /* Bottom Controls Row & Alignment Elements */
  .controls-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 0.2rem;
  }

  .empty-placeholder {
    width: 150px;
  }

  @media (max-width: 576px) {
    .controls-bottom-row {
      flex-direction: column;
      gap: 1rem;
    }
    .empty-placeholder {
      display: none;
    }
    .volume-container {
      margin: 0 auto;
    }
  }

  .vol-icon {
    color: hsl(var(--text-muted));
  }

  /* Two Column Playlist Section Layout */
  .playlist-section-two-cols {
    display: flex;
    gap: 2.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid hsla(var(--border-glass));
    padding-top: 1.5rem;
  }

  .playlist-col {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .playlist-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    margin-bottom: 1.2rem;
    color: #ffffff;
    font-weight: 700;
  }

  .playlist-header svg {
    color: hsl(var(--neon-purple));
    filter: drop-shadow(0 0 5px hsla(var(--neon-purple), 0.5));
  }

  .playlist-items {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    overflow: hidden;
    max-height: 270px; /* Standard: exactly 5 items */
    transition: max-height 0.4s ease-in-out;
  }

  .playlist-items.expanded {
    max-height: 1000px;
  }

  .btn-expand {
    margin-top: 0.8rem;
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
    border-radius: var(--radius-sm);
    border: 1px solid hsla(var(--border-glass));
    cursor: pointer;
    background: rgba(255,255,255,0.02);
    transition: var(--transition-smooth);
    align-self: center;
    color: hsl(var(--text-secondary));
  }

  .btn-expand:hover {
    background: rgba(255,255,255,0.06);
    color: #ffffff;
    border-color: hsla(var(--neon-purple), 0.4);
  }

  .playlist-item {
    display: flex;
    align-items: center;
    padding: 0.6rem 1rem;
    background: rgba(255,255,255,0.01);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    text-align: left;
    width: 100%;
    transition: var(--transition-smooth);
  }

  .playlist-item:hover {
    background: rgba(255,255,255,0.04);
    border-color: hsla(var(--border-glass));
  }

  .playlist-item.playing {
    border-color: hsla(var(--neon-purple), 0.3);
    background: hsla(var(--neon-purple), 0.08);
  }

  .playlist-cover {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    object-fit: cover;
    margin-right: 1rem;
  }

  .playlist-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .playlist-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
  }

  .playlist-item.playing .playlist-title {
    color: hsl(var(--neon-purple));
  }

  .playlist-artist {
    font-size: 0.75rem;
    color: hsl(var(--text-muted));
  }

  /* BGM Tag in Playlist item */
  .bgm-tag {
    background: hsla(var(--neon-purple), 0.2);
    border: 1px solid hsl(var(--neon-purple));
    color: hsl(var(--neon-purple));
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    margin-right: 0.5rem;
    text-shadow: 0 0 3px hsla(var(--neon-purple), 0.5);
    flex-shrink: 0;
  }

  .playlist-status-icon {
    font-size: 0.9rem;
    color: hsl(var(--text-muted));
    flex-shrink: 0;
  }

  .playlist-item.playing .playlist-status-icon {
    color: hsl(var(--neon-purple));
    animation: bounce 1s ease-in-out infinite alternate;
  }

  @media (max-width: 768px) {
    .music-player-container {
      flex-direction: column;
      padding: 1.5rem;
      gap: 2rem;
    }

    .player-left {
      width: 100%;
    }

    .playlist-section-two-cols {
      flex-direction: column;
      gap: 1.5rem;
    }
  }
</style>

<script>
  import { songs } from '../data/songs';

  document.addEventListener('astro:page-load', () => {
    // Script bindings for HTML5 Audio Player
    const audio = document.getElementById('main-audio') as HTMLAudioElement;
    if (!audio) return;

    const vinyl = document.getElementById('player-vinyl');
    const vinylArm = document.getElementById('player-arm');
    const vinylContainer = document.querySelector('.vinyl-container');
    const btnPlay = document.getElementById('btn-play');
    const iconPlay = document.querySelector('.icon-play');
    const iconPause = document.querySelector('.icon-pause');
    
    const progressBar = document.getElementById('progress-bar') as HTMLInputElement;
    const currentTimeLabel = document.getElementById('current-time');
    const durationTimeLabel = document.getElementById('duration-time');
    const volumeBar = document.getElementById('volume-bar') as HTMLInputElement;
    
    const songTitle = document.getElementById('player-song-title');
    const songArtist = document.getElementById('player-song-artist');
    const coverArt = document.getElementById('vinyl-cover-art');
    const lyricsContent = document.getElementById('lyrics-content');
    const lyricsScroll = document.getElementById('lyrics-scroll');
    
    const playlistItems = document.querySelectorAll('.playlist-item');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const btnBGM = document.getElementById('btn-background');

    let currentBGMId = localStorage.getItem('backgroundSongId') || '1';

    // Sync activeSongId from persistent audio element src
    let activeSongId = songs[0].id;
    const currentAudioSrc = audio.getAttribute('src') || '';
    const matchedSong = songs.find(s => s.url && currentAudioSrc.includes(s.url));
    if (matchedSong) {
      activeSongId = matchedSong.id;
    }

    const currentSong = songs.find(s => s.id === activeSongId) || songs[0];
    let activeSongLyrics: { time: number; text: string }[] = [];

    // Format time (e.g. 125 -> 2:05)
    function formatTime(secs: number) {
      if (isNaN(secs)) return '--:--';
      const minutes = Math.floor(secs / 60);
      const seconds = Math.floor(secs % 60);
      return `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
    }

    // Play & Pause controls
    function togglePlay() {
      if (audio.paused) {
        audio.play().then(() => {
          iconPlay?.classList.add('hidden');
          iconPause?.classList.remove('hidden');
          vinylContainer?.classList.add('playing');
          startWaveform();
        }).catch(err => console.log("Audio play blocked, wait for user interaction:", err));
      } else {
        audio.pause();
        iconPlay?.classList.remove('hidden');
        iconPause?.classList.add('hidden');
        vinylContainer?.classList.remove('playing');
        stopWaveform();
      }
    }

    if (btnPlay) {
      btnPlay.addEventListener('click', togglePlay);
    }

    // Audio loading logic
    audio.addEventListener('loadedmetadata', () => {
      if (progressBar) progressBar.max = audio.duration.toString();
      if (durationTimeLabel) durationTimeLabel.innerText = formatTime(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      if (progressBar) progressBar.value = audio.currentTime.toString();
      if (currentTimeLabel) currentTimeLabel.innerText = formatTime(audio.currentTime);
      updateLyrics(audio.currentTime);
    });

    audio.addEventListener('ended', () => {
      playNext();
    });

    // Time slider input change
    if (progressBar) {
      progressBar.addEventListener('input', () => {
        audio.currentTime = parseFloat(progressBar.value);
      });
    }

    // Volume slider input change
    if (volumeBar) {
      volumeBar.addEventListener('input', () => {
        audio.volume = parseFloat(volumeBar.value) / 100;
      });
    }

    // Parse LRC format to lyrics array
    function parseLRC(lrcText: string): { time: number; text: string }[] {
      const lines = lrcText.split('\n');
      const result: { time: number; text: string }[] = [];
      const timeReg = /\[(\d+):(\d+(?:\.\d+)?)\]/g;
      
      for (let line of lines) {
        line = line.trim();
        if (!line) continue;
        
        const matches = [...line.matchAll(timeReg)];
        if (matches.length === 0) continue;
        
        const text = line.replace(timeReg, '').trim();
        for (const match of matches) {
          const min = parseInt(match[1], 10);
          const sec = parseFloat(match[2]);
          const time = min * 60 + sec;
          result.push({ time, text });
        }
      }
      
      result.sort((a, b) => a.time - b.time);
      return result;
    }

    // Load lyrics from static URL
    async function loadLyrics(lyricsUrl: string) {
      if (!lyricsUrl) {
        return [{ time: 0, text: "暂无歌词" }];
      }
      try {
        const res = await fetch(lyricsUrl);
        if (!res.ok) throw new Error("Failed to load lyrics");
        const text = await res.text();
        return parseLRC(text);
      } catch (err) {
        console.error("Error loading lyrics:", err);
        return [{ time: 0, text: "歌词加载失败" }];
      }
    }

    // Render lyrics elements
    function renderLyrics(lyrics: { time: number; text: string }[]) {
      if (lyricsContent) {
        lyricsContent.innerHTML = lyrics.map((lyric, idx) => `
          <p class="lyric-line ${idx === 0 ? 'active' : ''}" data-time="${lyric.time}">
            ${lyric.text}
          </p>
        `).join('');
        lyricsContent.style.transform = 'translateY(40px)';
      }
    }

    // Lyrics tracker
    function updateLyrics(time: number) {
      if (!lyricsContent || activeSongLyrics.length === 0) return;
      
      let activeIndex = -1;
      for (let i = 0; i < activeSongLyrics.length; i++) {
        if (time >= activeSongLyrics[i].time) {
          activeIndex = i;
        } else {
          break;
        }
      }

      if (activeIndex !== -1) {
        const lines = lyricsContent.querySelectorAll('.lyric-line');
        lines.forEach((line, idx) => {
          if (idx === activeIndex) {
            line.classList.add('active');
            const containerHeight = lyricsScroll?.clientHeight || 120;
            const lineOffset = (line as HTMLElement).offsetTop;
            const lineHeight = (line as HTMLElement).clientHeight;
            if (lyricsContent) {
              lyricsContent.style.transform = `translateY(${containerHeight / 2 - lineOffset - lineHeight / 2}px)`;
            }
          } else {
            line.classList.remove('active');
          }
        });
      }
    }

    // BGM UI Tag synchronizer
    function updateBGMUI() {
      playlistItems.forEach(item => {
        const songId = item.getAttribute('data-id');
        const bgmTag = item.querySelector('.bgm-tag');
        if (bgmTag) {
          if (songId === currentBGMId) {
            bgmTag.classList.remove('hidden');
          } else {
            bgmTag.classList.add('hidden');
          }
        }
      });

      if (btnBGM) {
        if (activeSongId === currentBGMId) {
          btnBGM.classList.add('active');
        } else {
          btnBGM.classList.remove('active');
        }
      }
    }

    // Song switching logic by ID
    async function switchSong(id: string) {
      const song = songs.find(s => s.id === id);
      if (!song) return;
      
      activeSongId = id;

      playlistItems.forEach(item => {
        const itemId = item.getAttribute('data-id');
        if (itemId === id) {
          item.classList.add('playing');
          const parent = item.parentElement;
          if (parent) {
            parent.prepend(item);
          }
        } else {
          item.classList.remove('playing');
        }
      });

      if (songTitle) songTitle.innerText = song.title;
      if (songArtist) songArtist.innerText = song.artist;
      if (coverArt) coverArt.style.backgroundImage = `url('${song.cover}')`;

      if (lyricsContent) {
        lyricsContent.innerHTML = '<p class="lyric-line active">正在加载歌词...</p>';
      }

      activeSongLyrics = await loadLyrics(song.lyricsUrl);
      renderLyrics(activeSongLyrics);

      audio.src = song.url;
      audio.load();
      audio.play().then(() => {
        iconPlay?.classList.add('hidden');
        iconPause?.classList.remove('hidden');
        vinylContainer?.classList.add('playing');
        startWaveform();
      }).catch(err => {
        console.log("Auto play prevented on switch:", err);
        iconPlay?.classList.remove('hidden');
        iconPause?.classList.add('hidden');
        vinylContainer?.classList.remove('playing');
      });

      updateBGMUI();
    }

    // Play next/prev track
    function playNext() {
      const currentIndex = songs.findIndex(s => s.id === activeSongId);
      let nextIndex = currentIndex + 1;
      if (nextIndex >= songs.length) nextIndex = 0;
      switchSong(songs[nextIndex].id);
    }

    function playPrev() {
      const currentIndex = songs.findIndex(s => s.id === activeSongId);
      let prevIndex = currentIndex - 1;
      if (prevIndex < 0) prevIndex = songs.length - 1;
      switchSong(songs[prevIndex].id);
    }

    if (btnPrev) btnPrev.addEventListener('click', playPrev);
    if (btnNext) btnNext.addEventListener('click', playNext);

    playlistItems.forEach(item => {
      item.addEventListener('click', () => {
        const id = item.getAttribute('data-id');
        if (id) switchSong(id);
      });
    });

    if (btnBGM) {
      btnBGM.addEventListener('click', () => {
        currentBGMId = activeSongId;
        localStorage.setItem('backgroundSongId', currentBGMId);
        updateBGMUI();
      });
    }

    const expandBtns = document.querySelectorAll('.btn-expand');
    expandBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (targetId) {
          const list = document.getElementById(targetId);
          if (list) {
            list.classList.toggle('expanded');
            const isExpanded = list.classList.contains('expanded');
            btn.innerHTML = isExpanded ? '收起歌单 📁' : '展开更多 📂';
          }
        }
      });
    });

    // Initialize/Sync current UI elements based on song metadata
    if (songTitle) songTitle.innerText = currentSong.title;
    if (songArtist) songArtist.innerText = currentSong.artist;
    if (coverArt) coverArt.style.backgroundImage = `url('${currentSong.cover}')`;
    
    if (progressBar) {
      progressBar.max = isNaN(audio.duration) ? '100' : audio.duration.toString();
      progressBar.value = audio.currentTime.toString();
    }
    if (currentTimeLabel) currentTimeLabel.innerText = formatTime(audio.currentTime);
    if (durationTimeLabel) durationTimeLabel.innerText = isNaN(audio.duration) ? '--:--' : formatTime(audio.duration);
    if (volumeBar) volumeBar.value = (audio.volume * 100).toString();

    // Highlight and sort current playing item
    playlistItems.forEach(item => {
      const itemId = item.getAttribute('data-id');
      if (itemId === activeSongId) {
        item.classList.add('playing');
        const parent = item.parentElement;
        if (parent) {
          parent.prepend(item);
        }
      } else {
        item.classList.remove('playing');
      }
    });

    loadLyrics(currentSong.lyricsUrl).then(lyrics => {
      activeSongLyrics = lyrics;
      renderLyrics(lyrics);
      updateLyrics(audio.currentTime);
    });

    updateBGMUI();

    // Visualizer Canvas setup
    const canvas = document.getElementById('waveform-canvas') as HTMLCanvasElement;
    let ctx: CanvasRenderingContext2D | null = null;
    let animationId = 0;
    let isVisualizing = false;

    if (canvas) {
      ctx = canvas.getContext('2d');
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);
      drawWaveformStatic();
    }

    function resizeCanvas() {
      if (canvas) {
        canvas.width = canvas.parentElement?.clientWidth || 320;
        canvas.height = canvas.parentElement?.clientHeight || 60;
      }
    }

    function drawWaveformStatic() {
      if (!canvas || !ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const barsCount = 40;
      const barWidth = canvas.width / barsCount - 2;
      ctx.fillStyle = 'hsla(280, 100%, 60%, 0.2)';
      for (let i = 0; i < barsCount; i++) {
        const val = 10 + Math.sin(i * 0.3) * 15;
        ctx.fillRect(i * (barWidth + 2), canvas.height - val, barWidth, val);
      }
    }

    function startWaveform() {
      if (isVisualizing) return;
      isVisualizing = true;
      animateWave();
    }

    function stopWaveform() {
      isVisualizing = false;
      cancelAnimationFrame(animationId);
      drawWaveformStatic();
    }

    function animateWave() {
      if (!isVisualizing || !canvas || !ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      const barsCount = 35;
      const barWidth = canvas.width / barsCount - 3;
      const time = Date.now() * 0.005;

      for (let i = 0; i < barsCount; i++) {
        let heightVal = 10 + Math.abs(Math.sin(i * 0.4 + time) * 30);
        heightVal += Math.abs(Math.cos(i * 0.1 - time * 1.5) * 15);
        
        if (audio && audio.paused) {
          heightVal = 5;
        }
        
        const gradient = ctx.createLinearGradient(0, canvas.height - heightVal, 0, canvas.height);
        gradient.addColorStop(0, 'hsl(185, 100%, 50%)');
        gradient.addColorStop(1, 'hsl(280, 100%, 60%)');
        
        ctx.fillStyle = gradient;
        ctx.shadowBlur = 8;
        ctx.shadowColor = 'hsla(185, 100%, 50%, 0.5)';
        ctx.fillRect(i * (barWidth + 3), canvas.height - heightVal, barWidth, heightVal);
        ctx.shadowBlur = 0;
      }

      animationId = requestAnimationFrame(animateWave);
    }

    // Sync play state on initialization
    const isAudioPlaying = !audio.paused && audio.src !== '';
    if (isAudioPlaying) {
      iconPlay?.classList.add('hidden');
      iconPause?.classList.remove('hidden');
      vinylContainer?.classList.add('playing');
      startWaveform();
    } else {
      iconPlay?.classList.remove('hidden');
      iconPause?.classList.add('hidden');
      vinylContainer?.classList.remove('playing');
      stopWaveform();
    }

    audio.addEventListener('play', () => {
      iconPlay?.classList.add('hidden');
      iconPause?.classList.remove('hidden');
      vinylContainer?.classList.add('playing');
      startWaveform();
    });

    audio.addEventListener('pause', () => {
      iconPlay?.classList.remove('hidden');
      iconPause?.classList.add('hidden');
      vinylContainer?.classList.remove('playing');
      stopWaveform();
    });
  });
</script>
