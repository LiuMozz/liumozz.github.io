---
interface Song {
  id: string;
  title: string;
  artist: string;
  url: string;
  cover: string;
  lyrics: { time: number; text: string }[];
}

const songs: Song[] = [
  {
    id: "1",
    title: "Lofi Coding Dream",
    artist: "LiuMozz SoundLab",
    url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",
    cover: "https://images.unsplash.com/photo-1518495973542-4542c06a5843?w=300&auto=format&fit=crop&q=80",
    lyrics: [
      { time: 0, text: "🎵 [氛围纯音乐启动] 🎵" },
      { time: 5, text: "霓虹的光影穿透玻璃窗..." },
      { time: 12, text: "指尖在机械键盘上飞舞跳跃..." },
      { time: 20, text: "每一行代码都是一首未完的歌..." },
      { time: 28, text: "让思路在数字的世界里静静流淌..." },
      { time: 36, text: "构建我们最初梦想的避难所..." },
      { time: 45, text: "⚡ [音符在虚空中绽放] ⚡" },
      { time: 60, text: "在极简中寻求极致的宁静..." }
    ]
  },
  {
    id: "2",
    title: "Cyberpunk Midnight Pulse",
    artist: "Neon Matrix",
    url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3",
    cover: "https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=300&auto=format&fit=crop&q=80",
    lyrics: [
      { time: 0, text: "⚡ [电子合成器前奏] ⚡" },
      { time: 10, text: "穿梭于高耸的霓虹电网之间..." },
      { time: 18, text: "数据洪流在黑夜中脉动..." },
      { time: 26, text: "意识脱离重力的枷锁..." },
      { time: 35, text: "打破规则，重构未来..." },
      { time: 48, text: "🎹 [合成器独奏阶段] 🎹" },
      { time: 65, text: "与硅基生命在虚拟边缘相遇..." }
    ]
  }
];
---

<div class="music-player-container glass" id="custom-music-player">
  <div class="player-left">
    <!-- Vinyl Disc Section -->
    <div class="vinyl-container">
      <div class="vinyl-arm" id="player-arm"></div>
      <div class="vinyl-disc-large" id="player-vinyl">
        <div class="vinyl-center" id="vinyl-cover-art" style={`background-image: url('${songs[0].cover}')`}></div>
      </div>
    </div>
    
    <!-- Audio waves canvas -->
    <div class="canvas-container">
      <canvas id="waveform-canvas"></canvas>
    </div>
  </div>

  <div class="player-right">
    <!-- Song Info -->
    <div class="song-meta">
      <h2 class="song-title text-gradient-purple" id="player-song-title">{songs[0].title}</h2>
      <p class="song-artist" id="player-song-artist">{songs[0].artist}</p>
    </div>

    <!-- Lyrics Display -->
    <div class="lyrics-container" id="lyrics-scroll">
      <div class="lyrics-wrapper" id="lyrics-content">
        {songs[0].lyrics.map((lyric, idx) => (
          <p class="lyric-line" data-time={lyric.time} class={idx === 0 ? "active" : ""}>
            {lyric.text}
          </p>
        ))}
      </div>
    </div>

    <!-- Play Controls -->
    <div class="player-controls">
      <!-- HTML5 Audio -->
      <audio id="main-audio" src={songs[0].url}></audio>
      
      <!-- Progress Bar -->
      <div class="progress-bar-container">
        <span class="time-label" id="current-time">0:00</span>
        <input type="range" class="progress-slider" id="progress-bar" value="0" min="0" max="100" />
        <span class="time-label" id="duration-time">0:00</span>
      </div>
      
      <!-- Buttons -->
      <div class="control-buttons">
        <button class="btn-ctrl" id="btn-prev" aria-label="Previous Song">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><polygon points="19 20 9 12 19 4 19 20"></polygon><line x1="5" y1="19" x2="5" y2="5"></line></svg>
        </button>
        <button class="btn-ctrl btn-play-pause glass" id="btn-play" aria-label="Play/Pause">
          <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" class="icon-play"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" class="icon-pause hidden"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
        </button>
        <button class="btn-ctrl" id="btn-next" aria-label="Next Song">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><polygon points="5 4 15 12 5 20 5 4"></polygon><line x1="19" y1="5" x2="19" y2="19"></line></svg>
        </button>
      </div>

      <!-- Volume Bar -->
      <div class="volume-container">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" class="vol-icon"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
        <input type="range" class="volume-slider" id="volume-bar" value="80" min="0" max="100" />
      </div>
    </div>

    <!-- Play List Selection -->
    <div class="playlist-section">
      <h3 class="playlist-header">📂 播放歌单</h3>
      <div class="playlist-items">
        {songs.map((song, idx) => (
          <button 
            class={`playlist-item glass ${idx === 0 ? "playing" : ""}`} 
            data-id={song.id}
            data-title={song.title}
            data-artist={song.artist}
            data-url={song.url}
            data-cover={song.cover}
            data-lyrics={JSON.stringify(song.lyrics)}
          >
            <img src={song.cover} alt="Cover" class="playlist-cover" />
            <div class="playlist-meta">
              <span class="playlist-title">{song.title}</span>
              <span class="playlist-artist">{song.artist}</span>
            </div>
            <span class="playlist-status-icon">▶</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .music-player-container {
    display: flex;
    max-width: 1000px;
    width: 100%;
    margin: 2rem auto;
    padding: 2.5rem;
    gap: 3rem;
    border-color: hsla(var(--border-glass));
  }

  /* Left Panel */
  .player-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 320px;
  }

  .vinyl-container {
    position: relative;
    width: 280px;
    height: 280px;
    margin-bottom: 2rem;
  }

  .vinyl-arm {
    position: absolute;
    top: 5px;
    right: 25px;
    width: 90px;
    height: 90px;
    border-left: 3px solid #777;
    border-top: 3px solid #777;
    border-radius: 12px 0 0 0;
    transform: rotate(5deg);
    transform-origin: top right;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 5;
  }

  .vinyl-arm::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: -6px;
    width: 16px;
    height: 16px;
    background: #bbb;
    border-radius: 3px;
    box-shadow: 0 0 5px rgba(0,0,0,0.5);
  }

  .vinyl-container.playing .vinyl-arm {
    transform: rotate(26deg);
  }

  .vinyl-disc-large {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, #222 25%, #080808 60%, #151515 90%, #030303 100%);
    border: 4px solid #333;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: spin 15s linear infinite;
    animation-play-state: paused;
    margin: 10px auto;
  }

  .vinyl-container.playing .vinyl-disc-large {
    animation-play-state: running;
  }

  .vinyl-center {
    width: 85px;
    height: 85px;
    border-radius: 50%;
    border: 3px solid #111;
    background-size: cover;
    background-position: center;
  }

  .canvas-container {
    width: 100%;
    height: 60px;
    background: rgba(0,0,0,0.2);
    border-radius: var(--radius-sm);
    border: 1px solid hsla(var(--border-glass));
    overflow: hidden;
  }

  #waveform-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Right Panel */
  .player-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .song-meta {
    margin-bottom: 1.5rem;
  }

  .song-title {
    font-size: 2rem;
    margin-bottom: 0.3rem;
  }

  .song-artist {
    color: hsl(var(--text-secondary));
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* Lyrics Scroller */
  .lyrics-container {
    height: 120px;
    overflow-y: hidden;
    position: relative;
    margin-bottom: 2rem;
    border-top: 1px solid hsla(var(--border-glass));
    border-bottom: 1px solid hsla(var(--border-glass));
    padding: 1rem 0;
  }

  .lyrics-container::before, .lyrics-container::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 30px;
    pointer-events: none;
    z-index: 2;
  }

  .lyrics-container::before {
    top: 0;
    background: linear-gradient(to bottom, hsl(var(--card-bg)) 0%, transparent 100%);
  }

  .lyrics-container::after {
    bottom: 0;
    background: linear-gradient(to top, hsl(var(--card-bg)) 0%, transparent 100%);
  }

  .lyrics-wrapper {
    transition: transform 0.4s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .lyric-line {
    font-size: 0.95rem;
    color: hsl(var(--text-muted));
    text-align: center;
    transition: var(--transition-smooth);
    width: 100%;
  }

  .lyric-line.active {
    color: hsl(var(--neon-purple));
    font-weight: 600;
    font-size: 1.1rem;
    text-shadow: 0 0 10px hsla(var(--neon-purple), 0.4);
  }

  /* Controls layout */
  .player-controls {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin-bottom: 2rem;
  }

  .progress-bar-container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .time-label {
    font-family: monospace;
    font-size: 0.85rem;
    color: hsl(var(--text-muted));
    width: 40px;
  }

  .progress-slider, .volume-slider {
    flex: 1;
    -webkit-appearance: none;
    background: rgba(255,255,255,0.08);
    height: 6px;
    border-radius: 3px;
    outline: none;
    cursor: pointer;
  }

  .progress-slider::-webkit-slider-thumb, .volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: hsl(var(--neon-purple));
    box-shadow: 0 0 8px hsl(var(--neon-purple));
    transition: transform 0.1s ease;
  }

  .progress-slider::-webkit-slider-thumb:hover, .volume-slider::-webkit-slider-thumb:hover {
    transform: scale(1.3);
  }

  .control-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .btn-ctrl {
    background: transparent;
    border: none;
    color: hsl(var(--text-secondary));
    cursor: pointer;
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-ctrl:hover {
    color: #ffffff;
    transform: scale(1.1);
  }

  .btn-play-pause {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: hsla(var(--neon-purple), 0.15);
    border: 1px solid hsla(var(--neon-purple), 0.3);
    color: hsl(var(--neon-purple));
  }

  .btn-play-pause:hover {
    background: hsla(var(--neon-purple), 0.3);
    border-color: hsla(var(--neon-purple), 0.6);
    box-shadow: 0 0 15px hsla(var(--neon-purple), 0.4);
    color: #ffffff;
  }

  .hidden {
    display: none !important;
  }

  .volume-container {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 150px;
    margin: 0 auto;
  }

  .vol-icon {
    color: hsl(var(--text-muted));
  }

  /* Playlist style */
  .playlist-section {
    border-top: 1px solid hsla(var(--border-glass));
    padding-top: 1.5rem;
  }

  .playlist-header {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .playlist-items {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .playlist-item {
    display: flex;
    align-items: center;
    padding: 0.6rem 1rem;
    background: rgba(255,255,255,0.01);
    border-radius: var(--radius-sm);
    border-color: transparent;
    cursor: pointer;
    text-align: left;
    width: 100%;
  }

  .playlist-item:hover {
    background: rgba(255,255,255,0.04);
    border-color: hsla(var(--border-glass));
  }

  .playlist-item.playing {
    border-color: hsla(var(--neon-purple), 0.3);
    background: hsla(var(--neon-purple), 0.08);
  }

  .playlist-cover {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    object-fit: cover;
    margin-right: 1rem;
  }

  .playlist-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .playlist-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
  }

  .playlist-item.playing .playlist-title {
    color: hsl(var(--neon-purple));
  }

  .playlist-artist {
    font-size: 0.75rem;
    color: hsl(var(--text-muted));
  }

  .playlist-status-icon {
    font-size: 0.9rem;
    color: hsl(var(--text-muted));
  }

  .playlist-item.playing .playlist-status-icon {
    color: hsl(var(--neon-purple));
    animation: bounce 1s ease-in-out infinite alternate;
  }

  @media (max-width: 768px) {
    .music-player-container {
      flex-direction: column;
      padding: 1.5rem;
      gap: 2rem;
    }

    .player-left {
      width: 100%;
    }
  }
</style>

<script>
  // Script bindings for HTML5 Audio Player
  const audio = document.getElementById('main-audio') as HTMLAudioElement;
  const vinyl = document.getElementById('player-vinyl');
  const vinylArm = document.getElementById('player-arm');
  const vinylContainer = document.querySelector('.vinyl-container');
  const btnPlay = document.getElementById('btn-play');
  const iconPlay = document.querySelector('.icon-play');
  const iconPause = document.querySelector('.icon-pause');
  
  const progressBar = document.getElementById('progress-bar') as HTMLInputElement;
  const currentTimeLabel = document.getElementById('current-time');
  const durationTimeLabel = document.getElementById('duration-time');
  const volumeBar = document.getElementById('volume-bar') as HTMLInputElement;
  
  const songTitle = document.getElementById('player-song-title');
  const songArtist = document.getElementById('player-song-artist');
  const coverArt = document.getElementById('vinyl-cover-art');
  const lyricsContent = document.getElementById('lyrics-content');
  const lyricsScroll = document.getElementById('lyrics-scroll');
  
  const playlistItems = document.querySelectorAll('.playlist-item');
  const btnPrev = document.getElementById('btn-prev');
  const btnNext = document.getElementById('btn-next');

  let activeSongIndex = 0;
  let activeSongLyrics: { time: number; text: string }[] = [];

  // Parse lyrics from first song
  if (playlistItems.length > 0) {
    const defaultData = playlistItems[0].getAttribute('data-lyrics');
    if (defaultData) {
      activeSongLyrics = JSON.parse(defaultData);
    }
  }

  // Format time (e.g. 125 -> 2:05)
  function formatTime(secs: number) {
    const minutes = Math.floor(secs / 60);
    const seconds = Math.floor(secs % 60);
    return `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
  }

  // Play & Pause controls
  function togglePlay() {
    if (!audio) return;
    if (audio.paused) {
      audio.play().catch(err => console.log("Audio play blocked, wait for user interaction:", err));
      iconPlay?.classList.add('hidden');
      iconPause?.classList.remove('hidden');
      vinylContainer?.classList.add('playing');
      startWaveform();
    } else {
      audio.pause();
      iconPlay?.classList.remove('hidden');
      iconPause?.classList.add('hidden');
      vinylContainer?.classList.remove('playing');
      stopWaveform();
    }
  }

  if (btnPlay) {
    btnPlay.addEventListener('click', togglePlay);
  }

  // Audio loading logic
  if (audio) {
    audio.addEventListener('loadedmetadata', () => {
      if (progressBar) progressBar.max = audio.duration.toString();
      if (durationTimeLabel) durationTimeLabel.innerText = formatTime(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      if (progressBar) progressBar.value = audio.currentTime.toString();
      if (currentTimeLabel) currentTimeLabel.innerText = formatTime(audio.currentTime);
      updateLyrics(audio.currentTime);
    });

    audio.addEventListener('ended', () => {
      playNext();
    });
  }

  // Time slider input change
  if (progressBar) {
    progressBar.addEventListener('input', () => {
      if (audio) audio.currentTime = parseFloat(progressBar.value);
    });
  }

  // Volume slider input change
  if (volumeBar) {
    volumeBar.addEventListener('input', () => {
      if (audio) audio.volume = parseFloat(volumeBar.value) / 100;
    });
  }

  // Lyrics tracker
  function updateLyrics(time: number) {
    if (!lyricsContent || activeSongLyrics.length === 0) return;
    
    // Find active lyric line index
    let activeIndex = -1;
    for (let i = 0; i < activeSongLyrics.length; i++) {
      if (time >= activeSongLyrics[i].time) {
        activeIndex = i;
      } else {
        break;
      }
    }

    if (activeIndex !== -1) {
      const lines = lyricsContent.querySelectorAll('.lyric-line');
      lines.forEach((line, idx) => {
        if (idx === activeIndex) {
          line.classList.add('active');
          // Smooth scroll lyrics center
          const containerHeight = lyricsScroll?.clientHeight || 120;
          const lineOffset = (line as HTMLElement).offsetTop;
          const lineHeight = (line as HTMLElement).clientHeight;
          if (lyricsContent) {
            lyricsContent.style.transform = `translateY(${containerHeight / 2 - lineOffset - lineHeight / 2}px)`;
          }
        } else {
          line.classList.remove('active');
        }
      });
    }
  }

  // Song switching logic
  function switchSong(index: number) {
    if (index < 0 || index >= playlistItems.length) return;
    activeSongIndex = index;
    const item = playlistItems[index] as HTMLElement;
    const title = item.getAttribute('data-title') || '';
    const artist = item.getAttribute('data-artist') || '';
    const url = item.getAttribute('data-url') || '';
    const cover = item.getAttribute('data-cover') || '';
    const rawLyrics = item.getAttribute('data-lyrics') || '[]';

    // Update active highlight class
    playlistItems.forEach(pi => pi.classList.remove('playing'));
    item.classList.add('playing');

    // Update UI elements
    if (songTitle) songTitle.innerText = title;
    if (songArtist) songArtist.innerText = artist;
    if (coverArt) coverArt.style.backgroundImage = `url('${cover}')`;

    // Render lyrics in scroller
    activeSongLyrics = JSON.parse(rawLyrics);
    if (lyricsContent) {
      lyricsContent.innerHTML = activeSongLyrics.map((lyric, idx) => `
        <p class="lyric-line ${idx === 0 ? 'active' : ''}" data-time="${lyric.time}">
          ${lyric.text}
        </p>
      `).join('');
      lyricsContent.style.transform = 'translateY(40px)';
    }

    // Play audio
    if (audio) {
      audio.src = url;
      audio.load();
      // Auto play song on switch
      audio.play().then(() => {
        iconPlay?.classList.add('hidden');
        iconPause?.classList.remove('hidden');
        vinylContainer?.classList.add('playing');
        startWaveform();
      }).catch(err => {
        console.log("Auto play prevented on switch:", err);
        iconPlay?.classList.remove('hidden');
        iconPause?.classList.add('hidden');
        vinylContainer?.classList.remove('playing');
      });
    }
  }

  function playPrev() {
    let prevIndex = activeSongIndex - 1;
    if (prevIndex < 0) prevIndex = playlistItems.length - 1;
    switchSong(prevIndex);
  }

  function playNext() {
    let nextIndex = activeSongIndex + 1;
    if (nextIndex >= playlistItems.length) nextIndex = 0;
    switchSong(nextIndex);
  }

  if (btnPrev) btnPrev.addEventListener('click', playPrev);
  if (btnNext) btnNext.addEventListener('click', playNext);

  // Bind click selection on playlist
  playlistItems.forEach((item, idx) => {
    item.addEventListener('click', () => {
      switchSong(idx);
    });
  });

  // Simulated Glowing Waveform Visualizer
  const canvas = document.getElementById('waveform-canvas') as HTMLCanvasElement;
  let ctx: CanvasRenderingContext2D | null = null;
  let animationId = 0;
  let isVisualizing = false;

  if (canvas) {
    ctx = canvas.getContext('2d');
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    drawWaveformStatic(); // Initial static display
  }

  function resizeCanvas() {
    if (canvas) {
      canvas.width = canvas.parentElement?.clientWidth || 320;
      canvas.height = canvas.parentElement?.clientHeight || 60;
    }
  }

  function drawWaveformStatic() {
    if (!canvas || !ctx) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const barsCount = 40;
    const barWidth = canvas.width / barsCount - 2;
    ctx.fillStyle = 'hsla(280, 100%, 60%, 0.2)'; // Faded purple
    for (let i = 0; i < barsCount; i++) {
      const val = 10 + Math.sin(i * 0.3) * 15;
      ctx.fillRect(i * (barWidth + 2), canvas.height - val, barWidth, val);
    }
  }

  function startWaveform() {
    if (isVisualizing) return;
    isVisualizing = true;
    animateWave();
  }

  function stopWaveform() {
    isVisualizing = false;
    cancelAnimationFrame(animationId);
    drawWaveformStatic();
  }

  function animateWave() {
    if (!isVisualizing || !canvas || !ctx) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    const barsCount = 35;
    const barWidth = canvas.width / barsCount - 3;
    const time = Date.now() * 0.005;

    for (let i = 0; i < barsCount; i++) {
      // Calculate dynamic bar heights using noise-simulating sin functions
      let heightVal = 10 + Math.abs(Math.sin(i * 0.4 + time) * 30);
      heightVal += Math.abs(Math.cos(i * 0.1 - time * 1.5) * 15);
      
      // Scale height down if audio is playing a slow track (simulation)
      if (audio && audio.paused) {
        heightVal = 5;
      }
      
      // Color gradient transition cyan -> purple
      const gradient = ctx.createLinearGradient(0, canvas.height - heightVal, 0, canvas.height);
      gradient.addColorStop(0, 'hsl(185, 100%, 50%)'); // Cyan top
      gradient.addColorStop(1, 'hsl(280, 100%, 60%)'); // Purple base
      
      ctx.fillStyle = gradient;
      
      // Draw neon rounded glow shadow
      ctx.shadowBlur = 8;
      ctx.shadowColor = 'hsla(185, 100%, 50%, 0.5)';
      
      ctx.fillRect(i * (barWidth + 3), canvas.height - heightVal, barWidth, heightVal);
      
      // Reset shadow blur
      ctx.shadowBlur = 0;
    }

    animationId = requestAnimationFrame(animateWave);
  }
</script>
