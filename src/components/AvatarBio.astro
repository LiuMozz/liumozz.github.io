---
interface Props {
  avatarUrl?: string;
}

// ZJU official emblem: Qiushi Eagle in triangular composition (求是鹰)
const {
  avatarUrl = "https://github.com/LiuMozz.png",
} = Astro.props;
---

<div class="bio-wrapper glass" id="bio-container">
  <!-- Default State: Centered avatar + tagline -->
  <div class="default-state">
    <div class="avatar-circle-center">
      <img src={avatarUrl} alt="Avatar" class="avatar-img" />
      <div class="glow-ring"></div>
    </div>
    <p class="welcome-tagline">欢迎来到猛男妙妙屋 ⚡</p>
  </div>

  <!-- Active State: Avatar top-left + experience cards row -->
  <div class="active-state">
    <!-- Small avatar top-left -->
    <div class="avatar-small">
      <div class="avatar-circle-small">
        <img src={avatarUrl} alt="Avatar" class="avatar-img-small" />
      </div>
      <div class="avatar-info">
        <h2 class="bio-name text-gradient-cyan">LiuWhite</h2>
        <p class="bio-tagline">💻 开发者 | 🏋️ 技术与生活记录者</p>
      </div>
    </div>

    <!-- Experience Cards Row -->
    <div class="exp-cards-row">
      <!-- ZJU Education Card -->
      <a href="/experience" class="exp-card exp-card-zju" id="exp-card-edu">
        <div class="exp-card-logo">
          <img src="/logos/zju.svg" alt="浙江大学" class="org-logo org-logo-img" />
        </div>
        <div class="exp-card-body">
          <div class="exp-card-org">浙江大学</div>
          <div class="exp-card-period">2015.9 — 2022.9</div>
          <div class="exp-card-role">信电学院 · 本科 & 硕士</div>
        </div>
        <div class="exp-card-arrow">→</div>
      </a>

      <!-- Huawei Work Card -->
      <a href="/experience" class="exp-card exp-card-huawei" id="exp-card-hw">
        <div class="exp-card-logo">
          <!-- Huawei fan logo SVG (official style, simplified) -->
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="org-logo">
            <path fill="#C7000B" d="M3.67 6.14S1.82 7.91 1.72 9.78v.35c.08 1.51 1.22 2.4 1.22 2.4 1.83 1.79 6.26 4.04 7.3 4.55 0 0 .06.03.1-.01l.02-.04v-.04C7.52 10.8 3.67 6.14 3.67 6.14zM9.65 18.6c-.02-.08-.1-.08-.1-.08l-7.38.26c.8 1.43 2.15 2.53 3.56 2.2.96-.25 3.16-1.78 3.88-2.3.06-.05.04-.09.04-.09zm.08-.78C6.49 15.63.21 12.28.21 12.28c-.15.46-.2.9-.21 1.3v.07c0 1.07.4 1.82.4 1.82.8 1.69 2.34 2.2 2.34 2.2.7.3 1.4.31 1.4.31.12.02 4.4 0 5.54 0 .05 0 .08-.05.08-.05v-.06c0-.03-.03-.05-.03-.05zM9.06 3.19a3.42 3.42 0 00-2.57 3.15v.41c.03.6.16 1.05.16 1.05.66 2.9 3.86 7.65 4.55 8.65.05.05.1.03.1.03a.1.1 0 00.06-.1c1.06-10.6-1.11-13.42-1.11-13.42-.32.02-1.19.23-1.19.23zm8.299 2.27s-.49-1.8-2.44-2.28c0 0-.57-.14-1.17-.22 0 0-2.18 2.81-1.12 13.43.01.07.06.08.06.08.07.03.1-.03.1-.03.72-1.03 3.9-5.76 4.55-8.64 0 0 .36-1.4.02-2.34zm-2.92 13.07s-.07 0-.09.05c0 0-.01.07.03.1.7.51 2.85 2 3.88 2.3 0 0 .16.05.43.06h.14c.69-.02 1.9-.37 3-2.26l-7.4-.25zm7.83-8.41c.14-2.06-1.94-3.97-1.94-3.98 0 0-3.85 4.66-6.67 10.8 0 0-.03.08.02.13l.04.01h.06c1.06-.53 5.46-2.77 7.28-4.54 0 0 1.15-.93 1.21-2.42zm1.52 2.14s-6.28 3.37-9.52 5.55c0 0-.05.04-.03.11 0 0 .03.06.07.06 1.16 0 5.56 0 5.67-.02 0 0 .57-.02 1.27-.29 0 0 1.56-.5 2.37-2.27 0 0 .73-1.45.17-3.14z"/>
          </svg>
        </div>
        <div class="exp-card-body">
          <div class="exp-card-org">华为技术</div>
          <div class="exp-card-period">2022.10 — 2024.9</div>
          <div class="exp-card-role">昇腾推理开发部 · 推理开发工程师</div>
        </div>
        <div class="exp-card-arrow">→</div>
      </a>

      <!-- Ant Group Work Card -->
      <a href="/experience" class="exp-card exp-card-ant" id="exp-card-ant">
        <div class="exp-card-logo">
          <img src="/logos/ant-group.svg" alt="蚂蚁集团" class="org-logo org-logo-img" />
        </div>
        <div class="exp-card-body">
          <div class="exp-card-org">蚂蚁集团</div>
          <div class="exp-card-period">2024.9 — 至今</div>
          <div class="exp-card-role">财保事业群 AILab · 应用开发工程师</div>
        </div>
        <div class="exp-card-arrow">→</div>
      </a>
    </div>
  </div>
</div>

<style>
  .bio-wrapper {
    position: relative;
    width: 100%;
    max-width: 1100px;
    height: 280px;
    margin: 2rem auto 0.8rem;
    cursor: pointer;
    overflow: hidden;
    border-color: hsla(var(--border-glass));
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .bio-wrapper:hover {
    border-color: hsla(var(--neon-cyan), 0.3);
    box-shadow: 0 0 40px -8px hsla(var(--neon-cyan), 0.2);
  }

  /* ==================
     DEFAULT STATE
  ==================== */
  .default-state {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    transition: opacity 0.4s ease, transform 0.4s ease;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .bio-wrapper:hover .default-state {
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
  }

  .avatar-circle-center {
    position: relative;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, hsl(var(--neon-cyan)), hsl(var(--neon-purple)));
    box-shadow: 0 0 24px hsla(var(--neon-cyan), 0.35);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid hsl(var(--bg-color));
    display: block;
  }

  .glow-ring {
    position: absolute;
    top: -6px; left: -6px; right: -6px; bottom: -6px;
    border-radius: 50%;
    border: 2px solid transparent;
    background: linear-gradient(135deg, hsl(var(--neon-cyan)), hsl(var(--neon-purple))) border-box;
    mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    opacity: 0.5;
    animation: spin 10s linear infinite;
  }

  .welcome-tagline {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: hsl(var(--text-secondary));
    letter-spacing: 0.02em;
  }

  /* ==================
     ACTIVE STATE
  ==================== */
  .active-state {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 2rem;
    gap: 1.2rem;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease 0.05s, transform 0.4s ease 0.05s;
    pointer-events: none;
  }

  .bio-wrapper:hover .active-state {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Small avatar top-left */
  .avatar-small {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .avatar-circle-small {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    padding: 2px;
    background: linear-gradient(135deg, hsl(var(--neon-cyan)), hsl(var(--neon-purple)));
    flex-shrink: 0;
  }

  .avatar-img-small {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid hsl(var(--bg-color));
    display: block;
  }

  .avatar-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .bio-name {
    font-size: 1.3rem;
    margin: 0;
  }

  .bio-tagline {
    font-size: 0.82rem;
    color: hsl(var(--text-muted));
  }

  /* ==================
     EXPERIENCE CARDS ROW
  ==================== */
  .exp-cards-row {
    display: flex;
    gap: 1rem;
    flex: 1;
    align-items: stretch;
  }

  .exp-card {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .exp-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .exp-card:hover::before {
    opacity: 1;
  }

  /* ZJU: Zhejiang University Blue */
  .exp-card-zju {
    background: linear-gradient(135deg, rgba(0, 63, 136, 0.12), rgba(0, 63, 136, 0.05));
    border-color: rgba(0, 63, 136, 0.35);
  }

  .exp-card-zju:hover {
    background: linear-gradient(135deg, rgba(0, 63, 136, 0.22), rgba(0, 63, 136, 0.12));
    border-color: rgba(0, 63, 136, 0.65);
    box-shadow: 0 4px 20px -4px rgba(0, 63, 136, 0.4);
    transform: translateY(-2px);
  }

  .exp-card-zju .exp-card-org {
    color: rgb(60, 130, 220);
  }

  .exp-card-zju .exp-card-period {
    color: rgba(60, 130, 220, 0.75);
  }

  .exp-card-zju .exp-card-arrow {
    color: rgb(0, 63, 136);
  }

  /* Huawei: Red */
  .exp-card-huawei {
    background: linear-gradient(135deg, rgba(199, 0, 11, 0.12), rgba(199, 0, 11, 0.05));
    border-color: rgba(199, 0, 11, 0.35);
  }

  .exp-card-huawei:hover {
    background: linear-gradient(135deg, rgba(199, 0, 11, 0.22), rgba(199, 0, 11, 0.12));
    border-color: rgba(199, 0, 11, 0.65);
    box-shadow: 0 4px 20px -4px rgba(199, 0, 11, 0.4);
    transform: translateY(-2px);
  }

  .exp-card-huawei .exp-card-org {
    color: rgb(225, 60, 60);
  }

  .exp-card-huawei .exp-card-period {
    color: rgba(225, 60, 60, 0.75);
  }

  .exp-card-huawei .exp-card-arrow {
    color: rgb(199, 0, 11);
  }

  /* Ant Group: Blue */
  .exp-card-ant {
    background: linear-gradient(135deg, rgba(22, 119, 255, 0.12), rgba(22, 119, 255, 0.05));
    border-color: rgba(22, 119, 255, 0.35);
  }

  .exp-card-ant:hover {
    background: linear-gradient(135deg, rgba(22, 119, 255, 0.22), rgba(22, 119, 255, 0.12));
    border-color: rgba(22, 119, 255, 0.65);
    box-shadow: 0 4px 20px -4px rgba(22, 119, 255, 0.4);
    transform: translateY(-2px);
  }

  .exp-card-ant .exp-card-org {
    color: rgb(70, 148, 255);
  }

  .exp-card-ant .exp-card-period {
    color: rgba(70, 148, 255, 0.75);
  }

  .exp-card-ant .exp-card-arrow {
    color: rgb(22, 119, 255);
  }

  /* Card Logo Column */
  .exp-card-logo {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .org-logo {
    width: 36px;
    height: 36px;
  }

  .org-logo-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  /* Card Body */
  .exp-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .exp-card-org {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .exp-card-period {
    font-size: 0.75rem;
    font-weight: 500;
  }

  .exp-card-role {
    font-size: 0.72rem;
    color: hsl(var(--text-muted));
    line-height: 1.3;
  }

  /* Arrow */
  .exp-card-arrow {
    font-size: 1.1rem;
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .exp-card:hover .exp-card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ==================
     MOBILE
  ==================== */
  @media (max-width: 768px) {
    .bio-wrapper {
      height: auto;
      min-height: 220px;
    }

    .default-state {
      position: relative;
      opacity: 1;
      transform: none;
    }

    .active-state {
      display: none;
    }

    .bio-wrapper.touch-active .default-state {
      display: none;
    }

    .bio-wrapper.touch-active .active-state {
      display: flex;
      position: relative;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .exp-cards-row {
      flex-direction: column;
    }

    .exp-card {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const bio = document.getElementById('bio-container');
    if (bio) {
      // Mobile touch toggle
      bio.addEventListener('click', () => {
        if (window.innerWidth <= 768) {
          bio.classList.toggle('touch-active');
        }
      });
    }
  });
</script>
