---
---

<div class="video-modal-overlay" id="video-modal">
  <div class="modal-card glass">
    <!-- Close button -->
    <button class="btn-close-modal" id="modal-close" aria-label="Close Modal">&times;</button>
    
    <!-- Video Player Container -->
    <div class="custom-video-player" id="video-player-container">
      <video class="modal-video-tag" id="modal-video-el" src=""></video>
      
      <!-- Big Play Overlay Button -->
      <div class="video-big-play-btn" id="video-big-play">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
      </div>

      <!-- Custom Controls Bar (Plyr.js Style) -->
      <div class="video-controls-bar">
        <!-- Progress Bar -->
        <input type="range" class="video-timeline" id="video-timeline" value="0" min="0" max="100" />
        
        <div class="controls-bottom">
          <div class="controls-left">
            <!-- Play/Pause -->
            <button class="control-btn" id="video-play-btn">
              <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" class="play-icon"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" class="pause-icon hidden"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
            </button>
            
            <!-- Time label -->
            <span class="video-time-label" id="video-time-txt">0:00 / 0:00</span>
          </div>

          <div class="controls-right">
            <!-- Volume Slider -->
            <div class="video-vol-control">
              <button class="control-btn" id="video-mute-btn">
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" class="vol-on"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" class="vol-off hidden"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
              </button>
              <input type="range" class="video-volume-slider" id="video-volume" value="85" min="0" max="100" />
            </div>

            <!-- Fullscreen -->
            <button class="control-btn" id="video-fullscreen-btn">
              <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Video Info Panel -->
    <div class="modal-info-panel">
      <h2 class="modal-video-title text-gradient-cyan" id="modal-title-el">视频标题</h2>
      <p class="modal-video-desc" id="modal-desc-el">视频描述内容...</p>
    </div>
  </div>
</div>

<style>
  .video-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(5, 6, 10, 0.85);
    backdrop-filter: blur(20px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
    padding: 1rem;
  }

  .video-modal-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-card {
    position: relative;
    max-width: 900px;
    width: 100%;
    overflow: hidden;
    border-color: hsla(var(--border-glass));
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.8);
    transform: scale(0.9);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .video-modal-overlay.open .modal-card {
    transform: scale(1);
  }

  .btn-close-modal {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid hsla(var(--border-glass));
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: var(--transition-smooth);
  }

  .btn-close-modal:hover {
    background: #ff5f56;
    border-color: #ff5f56;
    box-shadow: 0 0 10px #ff5f56;
  }

  /* Custom Video Player Structure */
  .custom-video-player {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
    overflow: hidden;
  }

  .modal-video-tag {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .video-big-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(1);
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: hsla(var(--neon-cyan), 0.2);
    border: 2px solid hsl(var(--neon-cyan));
    color: hsl(var(--neon-cyan));
    box-shadow: 0 0 20px hsla(var(--neon-cyan), 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-bounce);
    z-index: 5;
  }

  .video-big-play-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background: hsla(var(--neon-cyan), 0.4);
  }

  .video-big-play-btn.hidden {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.8);
  }

  /* Control Bar Styling */
  .video-controls-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.4) 70%, transparent 100%);
    padding: 1.5rem 1.2rem 0.8rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    transform: translateY(100%);
    transition: transform 0.4s ease;
    z-index: 6;
  }

  .custom-video-player:hover .video-controls-bar,
  .custom-video-player:focus-within .video-controls-bar {
    transform: translateY(0);
  }

  .video-timeline {
    -webkit-appearance: none;
    width: 100%;
    background: rgba(255, 255, 255, 0.2);
    height: 5px;
    border-radius: 3px;
    outline: none;
    cursor: pointer;
    transition: height 0.1s ease;
  }

  .video-timeline:hover {
    height: 7px;
  }

  .video-timeline::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: hsl(var(--neon-cyan));
    box-shadow: 0 0 8px hsl(var(--neon-cyan));
  }

  .controls-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .controls-left, .controls-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .control-btn {
    background: transparent;
    border: none;
    color: hsl(var(--text-secondary));
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-smooth);
    padding: 0.2rem;
  }

  .control-btn:hover {
    color: hsl(var(--neon-cyan));
    text-shadow: 0 0 5px hsla(var(--neon-cyan), 0.5);
  }

  .video-time-label {
    font-family: monospace;
    font-size: 0.85rem;
    color: hsl(var(--text-secondary));
  }

  .video-vol-control {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .video-volume-slider {
    -webkit-appearance: none;
    background: rgba(255, 255, 255, 0.2);
    height: 4px;
    width: 70px;
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }

  .video-volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: hsl(var(--neon-cyan));
  }

  .modal-info-panel {
    padding: 1.5rem;
    background: hsl(var(--card-bg));
  }

  .modal-video-title {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .modal-video-desc {
    font-size: 0.9rem;
    color: hsl(var(--text-secondary));
    line-height: 1.5;
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Bind Video Modal control triggers
    const modal = document.getElementById('video-modal');
    const modalVideo = document.getElementById('modal-video-el') as HTMLVideoElement;
    const modalTitle = document.getElementById('modal-title-el');
    const modalDesc = document.getElementById('modal-desc-el');
    const modalClose = document.getElementById('modal-close');
    
    const videoPlayBtn = document.getElementById('video-play-btn');
    const playIcon = videoPlayBtn?.querySelector('.play-icon');
    const pauseIcon = videoPlayBtn?.querySelector('.pause-icon');
    
    const bigPlayBtn = document.getElementById('video-big-play');
    const timeline = document.getElementById('video-timeline') as HTMLInputElement;
    const timeLabel = document.getElementById('video-time-txt');
    
    const muteBtn = document.getElementById('video-mute-btn');
    const volOnIcon = muteBtn?.querySelector('.vol-on');
    const volOffIcon = muteBtn?.querySelector('.vol-off');
    const volumeSlider = document.getElementById('video-volume') as HTMLInputElement;
    const fullscreenBtn = document.getElementById('video-fullscreen-btn');
    const playerContainer = document.getElementById('video-player-container');

    // Trigger modal open from Video Cards
    const cards = document.querySelectorAll('[data-video-url]');
    cards.forEach(card => {
      card.addEventListener('click', () => {
        const videoUrl = card.getAttribute('data-video-url') || '';
        const title = card.getAttribute('data-video-title') || '';
        const desc = card.getAttribute('data-video-desc') || '';

        if (modal && modalVideo) {
          modalVideo.src = videoUrl;
          if (modalTitle) modalTitle.innerText = title;
          if (modalDesc) modalDesc.innerText = desc;
          
          modal.classList.add('open');
          
          // Auto play inside modal
          setTimeout(() => {
            modalVideo.play().then(() => {
              playIcon?.classList.add('hidden');
              pauseIcon?.classList.remove('hidden');
              bigPlayBtn?.classList.add('hidden');
            }).catch(err => {
              console.log("Autoplay on modal blocked, show big button:", err);
              bigPlayBtn?.classList.remove('hidden');
            });
          }, 100);
        }
      });
    });

    // Close modal logic
    function closeModal() {
      if (modal) {
        modal.classList.remove('open');
        if (modalVideo) {
          modalVideo.pause();
          modalVideo.src = ''; // Clear source to stop buffering
        }
      }
    }

    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        // Close only if clicked directly on overlay backdrop
        if (e.target === modal) {
          closeModal();
        }
      });
    }

    // Handle escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('open')) {
        closeModal();
      }
    });

    // Video Controls functions
    function toggleVideo() {
      if (!modalVideo) return;
      if (modalVideo.paused) {
        modalVideo.play();
        playIcon?.classList.add('hidden');
        pauseIcon?.classList.remove('hidden');
        bigPlayBtn?.classList.add('hidden');
      } else {
        modalVideo.pause();
        playIcon?.classList.remove('hidden');
        playIcon?.classList.remove('hidden');
        pauseIcon?.classList.add('hidden');
        bigPlayBtn?.classList.remove('hidden');
      }
    }

    if (videoPlayBtn) videoPlayBtn.addEventListener('click', toggleVideo);
    if (bigPlayBtn) bigPlayBtn.addEventListener('click', toggleVideo);
    if (modalVideo) {
      modalVideo.addEventListener('click', toggleVideo);
      
      // Updates
      modalVideo.addEventListener('timeupdate', () => {
        if (timeline) {
          timeline.value = ((modalVideo.currentTime / modalVideo.duration) * 100).toString();
        }
        updateTimeLabel();
      });

      modalVideo.addEventListener('loadedmetadata', () => {
        if (timeline) timeline.value = '0';
        updateTimeLabel();
      });
    }

    function formatDuration(secs: number) {
      if (isNaN(secs)) return '0:00';
      const minutes = Math.floor(secs / 60);
      const seconds = Math.floor(secs % 60);
      return `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
    }

    function updateTimeLabel() {
      if (modalVideo && timeLabel) {
        const current = formatDuration(modalVideo.currentTime);
        const total = formatDuration(modalVideo.duration);
        timeLabel.innerText = `${current} / ${total}`;
      }
    }

    // Timeline slider change
    if (timeline) {
      timeline.addEventListener('input', () => {
        if (modalVideo) {
          const time = (parseFloat(timeline.value) / 100) * modalVideo.duration;
          modalVideo.currentTime = time;
        }
      });
    }

    // Volume control
    if (volumeSlider) {
      volumeSlider.addEventListener('input', () => {
        if (modalVideo) {
          const val = parseFloat(volumeSlider.value) / 100;
          modalVideo.volume = val;
          modalVideo.muted = val === 0;
          
          if (val === 0) {
            volOnIcon?.classList.add('hidden');
            volOffIcon?.classList.remove('hidden');
          } else {
            volOnIcon?.classList.remove('hidden');
            volOffIcon?.classList.add('hidden');
          }
        }
      });
    }

    if (muteBtn) {
      muteBtn.addEventListener('click', () => {
        if (modalVideo) {
          modalVideo.muted = !modalVideo.muted;
          if (modalVideo.muted) {
            volOnIcon?.classList.add('hidden');
            volOffIcon?.classList.remove('hidden');
            if (volumeSlider) volumeSlider.value = '0';
          } else {
            volOnIcon?.classList.remove('hidden');
            volOffIcon?.classList.add('hidden');
            if (volumeSlider) volumeSlider.value = (modalVideo.volume * 100).toString();
          }
        }
      });
    }

    // Fullscreen
    if (fullscreenBtn && playerContainer) {
      fullscreenBtn.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          playerContainer.requestFullscreen().catch(err => {
            console.log("Error launching fullscreen:", err);
          });
        } else {
          document.exitFullscreen();
        }
      });
    }
  });
</script>
