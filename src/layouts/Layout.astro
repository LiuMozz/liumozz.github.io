---
import '../styles/index.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { 
  title = "猛男妙妙屋", 
  description = "欢迎来到猛男妙妙屋！这里记录我的开发日常、技术学习笔记以及对生活的思考。",
  image = "https://github.com/LiuMozz.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://liumozz.github.io/');
const isHome = Astro.url.pathname.replace(/\/$/, '') === '';
const showBackButton = !isHome;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={image} />

		<ClientRouter />

		<!-- Theme Initialization -->
		<script is:inline>
			(() => {
				const theme = localStorage.getItem('blog-theme') || 'default';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body>
		<!-- Fullscreen Theme Background Iframe -->
		<iframe id="theme-bg-iframe" class="theme-bg-iframe" src="" frameborder="0" allowtransparency="true" transition:persist></iframe>

		<!-- Glowing Navigation Header -->
		<header class="site-header glass">
			<nav class="nav-container">
				<a href="/" class="logo">
					<span class="logo-accent">⚡</span> 猛男妙妙屋
				</a>
				<ul class="nav-links">
					<li><a href="/" class={Astro.url.pathname === '/' ? 'active' : ''}>首页</a></li>
					<li><a href="/posts" class={Astro.url.pathname.startsWith('/posts') ? 'active' : ''}>Blog</a></li>
					<li><a href="/music" class={Astro.url.pathname.startsWith('/music') ? 'active' : ''}>音乐</a></li>
					<li><a href="/experience" class={Astro.url.pathname.startsWith('/experience') ? 'active' : ''}>经历</a></li>
					<li><a href="/gaming" class={Astro.url.pathname.startsWith('/gaming') ? 'active' : ''}>游戏</a></li>
					<li><a href="/travel" class={Astro.url.pathname.startsWith('/travel') ? 'active' : ''}>旅行</a></li>
					<li><a href="/archives" class={Astro.url.pathname.startsWith('/archives') ? 'active' : ''}>归档</a></li>
					<li>
						<a href="/search" class={Astro.url.pathname.startsWith('/search') ? 'active' : ''} id="nav-search-btn" title="搜索" aria-label="搜索">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
								<circle cx="11" cy="11" r="8"></circle>
								<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
							</svg>
						</a>
					</li>
					<li><button class="nav-theme-btn" id="nav-theme-btn" aria-label="切换主题">主题</button></li>
				</ul>
				<button class="mobile-nav-toggle" aria-label="Toggle Menu">
					<span></span>
					<span></span>
					<span></span>
				</button>
			</nav>
		</header>

		<!-- Main Page Area -->
		<main class="main-content">
			{showBackButton && (
				<div class="back-navigation">
					<button class="back-button glass" id="layout-back-btn" title="返回上一页" aria-label="返回">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="back-arrow-icon">
							<line x1="19" y1="12" x2="5" y2="12"></line>
							<polyline points="12 19 5 12 12 5"></polyline>
						</svg>
					</button>
				</div>
			)}
			<slot />
		</main>

		<!-- Theme Switcher Floating Panel -->
		<div class="theme-panel glass" id="theme-panel">
			<h4 class="theme-panel-title">🎨 背景选择</h4>
			<div class="theme-options">
				<button class="theme-option-btn glass active" data-theme="default">
					<span class="option-icon">⚫</span>
					<span class="option-name">经典极暗</span>
				</button>
				<button class="theme-option-btn glass" data-theme="galaxy">
					<span class="option-icon">🌌</span>
					<span class="option-name">银河星空</span>
				</button>
				<button class="theme-option-btn glass" data-theme="light">
					<span class="option-icon">☀️</span>
					<span class="option-name">温和明亮</span>
				</button>
			</div>
			<div class="theme-opacity-control">
				<div class="opacity-label-row">
					<span>背景透明度</span>
					<span id="theme-opacity-value">60%</span>
				</div>
				<input type="range" id="theme-opacity-slider" min="10" max="100" value="60" class="theme-opacity-slider" />
			</div>
		</div>

		<!-- Glowing Footer -->
		<footer class="site-footer glass">
			<div class="footer-content">
				<p class="copyright">&copy; {new Date().getFullYear()} LiuMozz. Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> ✨</p>
				<div class="socials">
					<a href="https://github.com/LiuMozz" target="_blank" rel="noopener" class="social-icon github" aria-label="GitHub">
						<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
					</a>
					<a href="mailto:liurushwhite@gmail.com" class="social-icon email" aria-label="Email">
						<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
					</a>
				</div>
			</div>
		</footer>

		<script>
			// Persist theme attribute on <html> element across Astro view transitions
			document.addEventListener('astro:before-swap', (ev) => {
				const theme = document.documentElement.getAttribute('data-theme');
				if (theme) {
					ev.newDocument.documentElement.setAttribute('data-theme', theme);
				}
			});

			document.addEventListener('astro:page-load', () => {
				// Back Button Navigation
				const backBtn = document.getElementById('layout-back-btn');
				if (backBtn) {
					backBtn.addEventListener('click', () => {
						history.back();
					});
				}

				// Mobile Navigation Toggle
				const toggleBtn = document.querySelector('.mobile-nav-toggle');
				const navLinks = document.querySelector('.nav-links');

				if (toggleBtn && navLinks) {
					toggleBtn.addEventListener('click', () => {
						toggleBtn.classList.toggle('active');
						navLinks.classList.toggle('open');
					});
				}

				// Theme Panel controls
				const themeBtn = document.getElementById('nav-theme-btn');
				const themePanel = document.getElementById('theme-panel');
				const iframe = document.getElementById('theme-bg-iframe') as HTMLIFrameElement;
				const opacitySlider = document.getElementById('theme-opacity-slider') as HTMLInputElement;
				const opacityValue = document.getElementById('theme-opacity-value');
				const optionBtns = document.querySelectorAll('.theme-option-btn');

				if (themeBtn && themePanel) {
					themeBtn.addEventListener('click', (e) => {
						e.stopPropagation();
						themePanel.classList.toggle('open');
						themeBtn.classList.toggle('active');
					});

					// Close panel if clicked outside
					document.addEventListener('click', (e) => {
						if (!themePanel.contains(e.target as Node) && e.target !== themeBtn) {
							themePanel.classList.remove('open');
							themeBtn.classList.remove('active');
						}
					});
				}

				// Apply stored settings
				let storedTheme = localStorage.getItem('blog-theme') || 'default';
				let storedOpacity = localStorage.getItem('blog-theme-opacity') || '60';

				function applyTheme(themeName: string, opacityPercent: string) {
					// Apply theme attribute to html element
					document.documentElement.setAttribute('data-theme', themeName);

					if (iframe) {
						if (themeName === 'galaxy') {
							// If already loaded galaxy, don't reload src to avoid reset
							const currentSrc = iframe.getAttribute('src');
							if (!currentSrc || !currentSrc.includes('/themes/galaxy.html')) {
								iframe.src = '/themes/galaxy.html';
							}
						} else {
							iframe.src = 'about:blank'; // Empty/Default dark background
						}
						iframe.style.opacity = (parseFloat(opacityPercent) / 100).toString();
					}

					// Update UI Panel Buttons
					optionBtns.forEach(btn => {
						const name = btn.getAttribute('data-theme');
						if (name === themeName) {
							btn.classList.add('active');
						} else {
							btn.classList.remove('active');
						}
					});

					// Update UI slider
					if (opacitySlider) opacitySlider.value = opacityPercent;
					if (opacityValue) opacityValue.innerText = `${opacityPercent}%`;
				}

				// Initial run on page load
				applyTheme(storedTheme, storedOpacity);

				// Bind option buttons click
				optionBtns.forEach(btn => {
					btn.addEventListener('click', () => {
						const selected = btn.getAttribute('data-theme') || 'default';
						storedTheme = selected;
						localStorage.setItem('blog-theme', selected);
						applyTheme(storedTheme, storedOpacity);
					});
				});

				// Bind opacity slider input
				if (opacitySlider) {
					opacitySlider.addEventListener('input', () => {
						const val = opacitySlider.value;
						storedOpacity = val;
						localStorage.setItem('blog-theme-opacity', val);
						applyTheme(storedTheme, storedOpacity);
					});
				}
			});

			// Glow card mouse tracker
			document.addEventListener('mousemove', (e) => {
				const cards = document.querySelectorAll('.glow-card');
				cards.forEach(card => {
					const rect = card.getBoundingClientRect();
					const x = e.clientX - rect.left;
					const y = e.clientY - rect.top;
					(card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
					(card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
				});
			});
		</script>
	</body>
</html>


