---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  author?: string;
  tags?: string[];
  headings: { depth: number; slug: string; text: string }[];
  body: string;
}

const { title, description, date, author = "LiuMozz", tags = [], headings = [], body } = Astro.props;

// Professional Chinese + English word count & reading time calculation
const cleanBody = body.replace(/```[\s\S]*?```/g, ''); // strip code blocks for count
const chineseChars = cleanBody.match(/[\u4e00-\u9fa5]/g)?.length || 0;
const englishWords = cleanBody.replace(/[\u4e00-\u9fa5]/g, ' ').split(/\s+/).filter(Boolean).length;
const totalWords = chineseChars + englishWords;
const readingTime = Math.max(1, Math.ceil(totalWords / 275)); // average reading speed
---

<Layout title={`${title} | 猛男妙妙屋`} description={description}>
  <article class="post-layout-container">
    <!-- Post Main Content Area -->
    <div class="post-main-column">
      <header class="post-header glass">
        <h1 class="post-title text-gradient-cyan">{title}</h1>
        <div class="post-meta-row">
          <span class="meta-item">📅 {date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span class="meta-item">✍️ {author}</span>
          <span class="meta-item">⏱️ 约 {totalWords} 字 / {readingTime} 分钟阅读</span>
        </div>
        {tags.length > 0 && (
          <div class="post-tags-list">
            {tags.map(tag => (
              <a href={`/tags/${tag}`} class="post-tag glass">#{tag}</a>
            ))}
          </div>
        )}
      </header>

      <div class="post-body-content glass prose">
        <slot />
      </div>
    </div>

    <!-- Table of Contents Sidebar (Desktop only) -->
    {headings.length > 0 && (
      <aside class="post-toc-column">
        <div class="toc-card glass">
          <h3 class="toc-title">📌 文章目录</h3>
          <ul class="toc-list">
            {headings.map(h => (
              <li class={`toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </article>
</Layout>

<style>
  .post-layout-container {
    display: flex;
    gap: 2rem;
    max-width: 1100px;
    width: 100%;
    margin: 2rem auto;
    align-items: flex-start;
  }

  .post-main-column {
    flex: 1;
    min-width: 0; /* Prevents flex overflow */
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-header {
    padding: 2.5rem;
    border-color: hsla(var(--border-glass));
  }

  .post-title {
    font-size: 2.4rem;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .post-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    color: hsl(var(--text-secondary));
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .post-tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .post-tag {
    font-size: 0.8rem;
    padding: 0.2rem 0.8rem;
    border-radius: 12px;
    color: hsl(var(--neon-cyan));
    border-color: hsla(var(--neon-cyan), 0.2);
    text-decoration: none;
    transition: var(--transition-smooth);
  }

  .post-tag:hover {
    background: hsla(var(--neon-cyan), 0.1);
    border-color: hsl(var(--neon-cyan));
    box-shadow: 0 0 10px hsla(var(--neon-cyan), 0.3);
  }

  .post-body-content {
    padding: 2.5rem;
    border-color: hsla(var(--border-glass));
  }

  /* Table of Contents Column */
  .post-toc-column {
    width: 260px;
    position: sticky;
    top: 100px;
    flex-shrink: 0;
  }

  .toc-card {
    padding: 1.5rem;
    border-color: hsla(var(--border-glass));
  }

  .toc-title {
    font-size: 1.1rem;
    color: #ffffff;
    margin-bottom: 1rem;
    border-bottom: 1px solid hsla(var(--border-glass));
    padding-bottom: 0.5rem;
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-height: 70vh;
    overflow-y: auto;
  }

  .toc-depth-1, .toc-depth-2 {
    padding-left: 0;
  }

  .toc-depth-3 {
    padding-left: 1rem;
    font-size: 0.9em;
  }

  .toc-link {
    color: hsl(var(--text-secondary));
    text-decoration: none;
    font-size: 0.88rem;
    transition: var(--transition-smooth);
    border-left: 2px solid transparent;
    padding-left: 0.5rem;
    display: block;
  }

  .toc-link:hover {
    color: hsl(var(--neon-cyan));
    border-left-color: hsl(var(--neon-cyan));
    padding-left: 0.8rem;
  }

  @media (max-width: 900px) {
    .post-toc-column {
      display: none;
    }
  }
</style>
